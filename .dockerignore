# The image does `COPY . /opt/kubiscan`, and .gitignore has no effect on a
# Docker build - only this file does. Without it the build sweeps in whatever
# happens to sit in the working directory: the v1 image shipped a 79 MB .venv
# and a 90 MB dist/kubiscan-minikube.tar, tripling its size.

# Version control and local tooling
.git
.gitignore
.gitattributes
.claude
.idea
.vscode

# Virtualenvs
.venv
venv
env
ENV

# Build and packaging output
dist
build
*.egg-info
*.egg
*.spec

# Python bytecode and caches. The '**/' matters: a bare '__pycache__' pattern
# only matches at the context root, so every engine/__pycache__ was still being
# copied into the image.
**/__pycache__
**/*.py[cod]
.mypy_cache
.pytest_cache
.coverage
coverage.xml

# Scratch files
tmp_*
*.log
*.tmp
*.bak
*.orig

# Container and deployment definitions are not needed at runtime.
# The Dockerfiles are deliberately NOT excluded: 'minikube image build' and other
# builders that read the Dockerfile out of the transferred context fail outright
# when it is missing, and the files cost a few kilobytes.
.dockerignore
deploy
